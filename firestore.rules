rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leads/{leadId} {
      // Allow creation when required customer fields are present
      allow create: if request.resource.data.fullName is string 
                    && request.resource.data.whatsapp is string;
      // Allow read, update, and delete for the administration panel
      allow read, update, delete: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
